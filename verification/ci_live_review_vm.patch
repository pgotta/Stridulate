+        // A visible live result is a review card, not an ephemeral current-window label.
+        // Once the tester judges it, clear that card and suppress the same continuous
+        // top label until the acoustic event ends or a different top label appears.
+        reviewedLiveTopLabel = candidateLabel
+        pendingLiveFeedbackSnapshot = null
+        _liveCandidates.value = emptyList()
+        _liveLegacyCandidates.value = emptyList()
+
+        val acknowledgement = when (verdict) {
+            FeedbackVerdict.CORRECT -> "✓ Correct saved"
+            FeedbackVerdict.INCORRECT -> "✕ Incorrect saved"
+            FeedbackVerdict.NOISE -> "Noise saved"
+        }
+        _liveFeedbackAck.value = acknowledgement
+        liveFeedbackAckJob?.cancel()
+        liveFeedbackAckJob = viewModelScope.launch {
+            delay(1400L)
+            if (_liveFeedbackAck.value == acknowledgement) _liveFeedbackAck.value = null
+        }
     }
 

+    private fun updateLiveHeardState(
+        freshCandidates: List<Candidate>,
+        freshLegacyCandidates: List<Candidate>,
+        assessment: InsectSignalAssessment
+    ) {
+        _liveHeardNow.value = assessment.passed &&
+            (freshCandidates.isNotEmpty() || freshLegacyCandidates.isNotEmpty())
+
+        val freshTopLabel = freshCandidates.firstOrNull()?.label
+        if (!assessment.passed) {
+            reviewedLiveTopLabel = null
+        } else if (freshTopLabel != null && reviewedLiveTopLabel != null && reviewedLiveTopLabel != freshTopLabel) {
+            reviewedLiveTopLabel = null
+        }
+    }
+
+    private fun latchLiveReviewIfAvailable(
+        freshCandidates: List<Candidate>,
+        freshLegacyCandidates: List<Candidate>,
+        snapshot: TestFeedbackSnapshot?
+    ) {
+        if (pendingLiveFeedbackSnapshot != null) return
+        if (_liveCandidates.value.isNotEmpty() || _liveLegacyCandidates.value.isNotEmpty()) return
+
+        val top = freshCandidates.firstOrNull() ?: return
+        if (top.label == reviewedLiveTopLabel) return
+
+        val frozenSnapshot = snapshot ?: return
+        _liveCandidates.value = freshCandidates
+        _liveLegacyCandidates.value = freshLegacyCandidates
+        pendingLiveFeedbackSnapshot = frozenSnapshot
+    }
